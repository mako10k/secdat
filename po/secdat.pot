msgstr ""

#: src/cli.c:2085
msgid ""
"  load: import a passphrase-protected bundle through one v2 mutation plan "
"and one recoverable transaction\n"
msgstr ""

#: src/cli.c:2086
msgid ""
"  --conflict=reject is the default and rejects any destination name visible "
