#, c-format
msgid ""
"\n"
"Topics:\n"
msgstr ""

#: src/cli.c:1897 src/cli.c:2124
msgid ""
"  usecases: show example workflows and task-oriented command combinations\n"
msgstr ""

#: src/cli.c:1898
