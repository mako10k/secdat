#: src/cli.c:2019
msgid ""
"  --mask-chain must identify a chain that protects the requested key; --dry-"
"run/--json list every affected authorized key slot\n"
msgstr ""

#: src/cli.c:2020
msgid ""
"  deferred-exposure warnings default to on; --mask-warnings=default|on|off, "
