# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project SECDAT_EPHEMERAL_REVIEW_FIXES:
  version 6
  title "secdat per-key ephemeral review fixes"
  description "Root-cause repair plan for WIP commit 7ce5faaf and GitHub issues 174 through 179. Issue closure, push, release, and activation remain separate authorization gates."
  as_of 2026-08-06
  duration_unit day
  finish M_CLOSED
  goal_owner user
  goal_delegates [codex]
  dag_owner user
  dag_delegates [codex]
  plan_assurance_model 1
  plan_assurance_hash_model 1

milestone M_FINDINGS:
  title "Review findings recorded as issues"
  state reached

resource CODEX:
  title "Codex implementation and review"
  description "Single-agent implementation capacity; no parallel source edits"
  capacity 1

milestone M_ENUM_CORRECT:
  title "Effective enumeration is overlay-correct"
  description "All key enumeration paths use overlay precedence before backing-store visibility."

milestone M_CORE_FIXES:
  title "All core fixes complete"
  description "Enumeration, list attributes, lifecycle purge, FUSE atomicity, and help discoverability are fixed."

milestone M_COVERAGE:
  title "Regression matrix complete"
  description "Cross-surface per-key ephemeral regression coverage is complete."

milestone M_ACCEPTED:
  title "Implementation accepted"
  description "Full verification and consistency, symmetry, and coverage review pass."

milestone M_CLOSED:
  title "Issue closeout prepared"
  description "Verified closeout evidence is ready for issues 174 through 179 and parent 170."

task T174_ENUMERATION M_FINDINGS -> M_ENUM_CORRECT:
  title "Fix effective key enumeration overlay precedence"
  description "Create one effective enumeration projection that applies ephemeral overlay entries and tombstones before backing-store visibility. Cover same-domain tombstones, v2 hidden persisted shadows, wrong process environments, downstream save rejection, SDK, exec, export, FUSE, and status consumers."
  duration 2d
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [enumeration, security, root-cause]
  source "GitHub #174"

task T175_LIST_ATTRS M_ENUM_CORRECT -> M_CORE_FIXES:
  title "Preserve ephemeral attributes in current-domain list filters"
  description "Carry authoritative overlay attributes through current-domain list and bulk-gate filtering. Add exclude, named, and include-mode parity tests for ls and list."
  duration 0.5d
  priority 85
  requires:
    CODEX 1
  owner "codex"
  tags [enumeration, attributes, symmetry]
  source "GitHub #175"

task T176_LIFECYCLE M_FINDINGS -> M_CORE_FIXES:
  title "Purge inherited-agent ephemeral entries on domain lock"
  description "Purge the locked or replaced child domain from whichever inherited agent owns its ephemeral entries without affecting sibling domains. Prove lock, unlock --inherit, replacement, and sibling-isolation behavior."
  duration 1.5d
  priority 80
  requires:
    CODEX 1
  owner "codex"
  tags [lifecycle, isolation, security]
  source "GitHub #176"

task T177_FUSE_ATOMIC M_FINDINGS -> M_CORE_FIXES:
  title "Make FUSE ephemeral write rejection atomic"
  description "Move ephemeral-state validation into the same authoritative update boundary as SDK/FUSE read-modify-write. Add a deterministic interleaving regression test and prove rejected writes leave persisted and ephemeral state unchanged."
  duration 2.5d
  status done
  priority 100
  requires:
    CODEX 1
  owner "codex"
  tags [fuse, atomicity, security, root-cause]
  source "GitHub #177"

task T178_HELP M_FINDINGS -> M_CORE_FIXES:
  title "Restore set and rm option discoverability"
  description "Restore established unsafe and ignore option guidance while retaining ephemeral markers in top-level help. Add exact help-contract regression coverage."
  duration 0.25d
  priority 40
  requires:
    CODEX 1
  owner "codex"
  tags [cli, help, compatibility]
  source "GitHub #178"

task T179_MATRIX M_CORE_FIXES -> M_COVERAGE:
  title "Complete the per-key ephemeral regression matrix"
  description "Close the remaining CLI, SDK, FUSE, lifecycle, binary-value, old-agent compatibility, enumeration, and attribute-filter symmetry gaps. Map every matrix cell to a named automated test."
  duration 2d
  priority 70
  requires:
    CODEX 1
  owner "codex"
  tags [coverage, symmetry, compatibility]
  source "GitHub #179"

task T_ACCEPT M_COVERAGE -> M_ACCEPTED:
  title "Run full acceptance and symmetry review"
  description "Run make check, relevant warning-clean builds including FUSE where optional, git diff --check, and a fresh consistency, symmetry, and coverage review. Acceptance requires no unresolved high- or medium-severity finding."
  duration 1d
  priority 60
  requires:
    CODEX 1
  owner "codex"
  tags [verification, review, acceptance]
  source "GitHub #170"

task T_CLOSE M_ACCEPTED -> M_CLOSED:
  title "Prepare final commit and verified issue closeout"
  description "After acceptance, create the review-approved non-WIP commit and prepare evidence-backed comments for readback and closeout of issues 174 through 179 and parent 170. Closing issues and pushing remain explicit external-action gates."
  duration 0.25d
  priority 10
  requires:
    CODEX 1
  owner "codex"
  tags [commit, closeout, evidence]
  source "GitHub #170, #174-#179"

