# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project SECDAT_SECRET_BUNDLES:
  version 6
  title "secdat secure generation and selective bundles"
  description "Plan derived from a zero-warning llmthink design audit. GitHub issue creation precedes source edits. External publication, issue closure, and release remain separately authorized."
  as_of 2026-08-12
  duration_unit point
  velocity 5p/1d
  finish M_CLOSED
  goal_owner user
  goal_delegates [codex]
  dag_owner user
  dag_delegates [codex]

milestone NOW:
  title "Design plan created"
  state reached

resource CODEX:
  title "Codex implementation and review capacity"
  capacity 1

milestone M_ISSUE_INTAKE:
  title "Implementation issues recorded"

milestone M_CONTRACT:
  title "Public contract accepted"

milestone M_GENERATION:
  title "Secret generation accepted"

milestone M_BUNDLE_V2:
  title "Bundle v2 accepted"

milestone M_SELECTED_EXPORT:
  title "Selected export accepted"

milestone M_SINGLE_TARGET_IMPORT:
  title "Single-target import accepted"

milestone M_ORIGIN_RESTORE:
  title "Origin restore accepted"

milestone M_ACCEPTED:
  title "Full acceptance complete"

milestone M_CLOSED:
  title "Review-ready closeout prepared"

task T_ISSUE_INTAKE NOW -> M_ISSUE_INTAKE:
  title "Record implementation issues and acceptance boundaries"
  description "Create separate tracked issues for generation and bundle work before source changes; record scope, non-goals, compatibility requirements, and independent authorization boundaries."
  duration 1p
  priority 100
  requires:
    CODEX 1
  owner "codex"
  tags [governance, issue-intake]
  source "User request 2026-08-12"

task T_CONTRACT M_ISSUE_INTAKE -> M_CONTRACT:
  title "Specify generation and bundle v2 contracts"
  description "Define set generation syntax, charset presets, composition semantics, value non-disclosure, bundle v1/v2 compatibility, logical-copy records, attribute preservation, AEAD associated data, duplicate policy, and restore modes. Update specifications before implementation."
  duration 4p
  priority 95
  requires:
    CODEX 1
  owner "codex"
  tags [contract, security]
  source "llmthink thought-2026-08-12T02-37-26-412Z"

task T_GENERATION M_CONTRACT -> M_GENERATION:
  title "Implement generated secret writes through set"
  description "Use CSPRNG rejection sampling and class-aware construction inside the existing set mutation plan. Preserve KEYREF, masks, session modes, attributes, dry-run, JSON redaction, and transaction behavior. Add focused regressions."
  duration 5p
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [generation, security]
  source "Generation contract"

task T_BUNDLE_V2 M_GENERATION -> M_BUNDLE_V2:
  title "Implement authenticated logical bundle v2"
  description "Add versioned passphrase-protected logical-copy records with source domain, store, key, value, and restoration attributes. Authenticate immutable metadata as AEAD associated data; retain read support for v1 and reject malformed or unsupported v2 input before mutation."
  duration 8p
  priority 85
  requires:
    CODEX 1
  owner "codex"
  tags [bundle, crypto, compatibility]
  source "Bundle v2 contract"

task T_SELECTED_EXPORT M_BUNDLE_V2 -> M_SELECTED_EXPORT:
  title "Implement explicit key-set export"
  description "Extend save with repeated canonical KEYREF selection while preserving legacy current-view save. Reject ephemeral entries and unavailable keys before bundle creation; do not export object identity, wrapped keys, or link topology."
  duration 5p
  priority 80
  requires:
    CODEX 1
  owner "codex"
  tags [export, keyref]
  source "Bundle selection contract"

task T_SINGLE_TARGET_IMPORT M_SELECTED_EXPORT -> M_SINGLE_TARGET_IMPORT:
  title "Implement validated single-target import"
  description "Keep load compatibility for a current destination. Preflight full payload, key validity, duplicate destination names, attributes, mutability, and mask impact before a recoverable transaction; retain existing keys absent from the bundle."
  duration 6p
  priority 75
  requires:
    CODEX 1
  owner "codex"
  tags [import, transaction]
  source "Import compatibility contract"

task T_ORIGIN_RESTORE M_SINGLE_TARGET_IMPORT -> M_ORIGIN_RESTORE:
  title "Implement explicit multi-scope origin restore"
  description "Add opt-in origin restoration only after a coordinator can preflight every registered target and recover safely from a multi-scope failure. Do not auto-create domains or stores; leave cross-machine mapping for a later approved contract."
  duration 13p
  priority 70
  requires:
    CODEX 1
  owner "codex"
  tags [import, recovery, multi-scope]
  source "Multi-scope restoration contract"

task T_ACCEPT M_ORIGIN_RESTORE -> M_ACCEPTED:
  title "Run security, compatibility, and regression acceptance"
  description "Complete static review, focused generation and save/load tests, mask and transaction fault cases, tamper and wrong-passphrase tests, v1 compatibility, optional FUSE coverage where relevant, make check, documentation, completion, manpage, and Japanese catalog validation."
  duration 6p
  priority 60
  requires:
    CODEX 1
  owner "codex"
  tags [verification, compatibility]
  source "Repository acceptance policy"

task T_CLOSE M_ACCEPTED -> M_CLOSED:
  title "Prepare review-approved implementation closeout"
  description "After review and exact validation receipts, prepare the non-WIP candidate and issue-result evidence. Commit, issue closure, push, release, and publication require their own explicit authorization."
  duration 2p
  priority 10
  requires:
    CODEX 1
  owner "codex"
  tags [review, closeout]
  source "Repository closeout policy"
