# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project SECDAT_SECRET_BUNDLES:
  version 6
  title "secdat secure generation and selective bundles"
  description "Plan derived from a zero-warning llmthink design audit. GitHub issue creation precedes source edits. External publication, issue closure, and release remain separately authorized."
  as_of 2026-08-12
  duration_unit point
  velocity 5p/1d
  finish M_CLOSED
  goal_owner user
  goal_delegates [codex]
  dag_owner user
  dag_delegates [codex]

milestone NOW:
  title "Design plan created"
  state reached

resource CODEX:
  title "Codex implementation and review capacity"
  capacity 1

milestone M_ISSUE_INTAKE:
  title "Implementation issues recorded"

milestone M_CONTRACT:
  title "Public contract accepted"

milestone M_GENERATION:
  title "Secret generation accepted"

milestone M_BUNDLE_V2:
  title "Bundle v2 accepted"

milestone M_SELECTED_EXPORT:
  title "Selected export accepted"

milestone M_SINGLE_TARGET_IMPORT:
  title "Single-target import accepted"


milestone M_ACCEPTED:
  title "Full acceptance complete"

milestone M_CLOSED:
  title "Review-ready closeout prepared"

task T_ISSUE_INTAKE NOW -> M_ISSUE_INTAKE:
  title "Record implementation issues and acceptance boundaries"
  description "Create separate tracked issues for generation and bundle work before source changes; record scope, non-goals, compatibility requirements, and independent authorization boundaries."
  duration 1p
  priority 100
  requires:
    CODEX 1
  owner "codex"
  tags [governance, issue-intake]
  source "User request 2026-08-12"

task T_CONTRACT M_ISSUE_INTAKE -> M_CONTRACT:
  title "Specify generation and bundle v2 contracts"
  description "Define set generation syntax, charset presets, composition semantics, value non-disclosure, portable bundle v1/v2 compatibility, base-name-only records, v2 bundle-local label/object linkage, and single-target collision modes. Exclude source-domain and store metadata, inheritance, masks, attributes, UUIDs, wrapped keys, automatic target creation, and origin restoration."
  duration 4p
  priority 95
  requires:
    CODEX 1
  owner "codex"
  tags [contract, security]
  source "llmthink thought-2026-08-12T02-37-26-412Z"

task T_GENERATION M_CONTRACT -> M_GENERATION:
  title "Implement generated secret writes through set"
  description "Use CSPRNG rejection sampling and class-aware construction inside the existing set mutation plan. Preserve KEYREF, masks, session modes, attributes, dry-run, JSON redaction, and transaction behavior. Add focused regressions."
  duration 5p
  priority 90
  requires:
    CODEX 1
  owner "codex"
  tags [generation, security]
  source "Generation contract"

task T_BUNDLE_V2 M_GENERATION -> M_BUNDLE_V2:
  title "Implement portable logical bundle v2"
  description "Define a portable v2 bundle containing no source domain, store, inheritance, mask, attribute, UUID, or wrapped-key metadata. Save resolves source names first; v2 stores bundle-local object data separately from base-name labels so selected intra-bundle links can be reconstructed. Retain v1 read compatibility and reject malformed input before mutation."
  duration 8p
  priority 85
  requires:
    CODEX 1
  owner "codex"
  tags [bundle, crypto, compatibility]
  source "Bundle v2 contract"

task T_SELECTED_EXPORT M_BUNDLE_V2 -> M_SELECTED_EXPORT:
  title "Align selected save with ls-resolved base names"
  description "Keep legacy current-view save. With --key, select unique base names from the explicitly selected --dir and --store scope, resolving them through the same effective-view rules as ls. Serialize base names only; source scope and other origin metadata never enter the bundle."
  duration 5p
  priority 80
  requires:
    CODEX 1
  owner "codex"
  tags [save, selection]
  source "Bundle selection contract"

task T_SINGLE_TARGET_IMPORT M_SELECTED_EXPORT -> M_SINGLE_TARGET_IMPORT:
  title "Preflight collision-safe single-target load"
  description "Load into one explicitly selected --dir and --store destination. Default conflict=reject requires no effective destination name collisions; conflict=overwrite replaces colliding labels and conflict=skip leaves colliding labels untouched. Reject duplicate bundle base names and malformed data before any mutation; preserve unspecified destination names."
  duration 6p
  priority 75
  requires:
    CODEX 1
  owner "codex"
  tags [import, transaction]
  source "Import compatibility contract"


task T_ACCEPT M_SINGLE_TARGET_IMPORT -> M_ACCEPTED:
  title "Run security, compatibility, and regression acceptance"
  description "Complete static review and focused save/load acceptance: v1 compatibility, v2 label/object and selected-link reconstruction, ls-aligned selection, wrong-passphrase and tamper failures, duplicate-name rejection, each conflict policy, mask and transaction faults, completion, documentation, Japanese catalog, optional FUSE relevance, and make check. No origin restoration, domain/store creation, or source metadata migration is in scope."
  duration 6p
  priority 60
  requires:
    CODEX 1
  owner "codex"
  tags [verification, compatibility]
  source "Repository acceptance policy"

task T_CLOSE M_ACCEPTED -> M_CLOSED:
  title "Prepare review-approved implementation closeout"
  description "After review and exact validation receipts, prepare the non-WIP candidate and issue-result evidence. Commit, issue closure, push, release, and publication require their own explicit authorization."
  duration 2p
  priority 10
  requires:
    CODEX 1
  owner "codex"
  tags [review, closeout]
  source "Repository closeout policy"
